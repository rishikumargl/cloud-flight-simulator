# Cloud Flight Simulator - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# SQLite (development - auto-creates):
DATABASE_URL=sqlite:///./feedback.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/cloud_flight_db

# ============================================================================
# HUGGINGFACE LLM CONFIGURATION
# ============================================================================

# HuggingFace API Token (required for using HF Router with OpenAI models)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_actual_token_here

# ============================================================================
# LANGSMITH TRACING (Optional)
# ============================================================================

# LangSmith API Key for tracing feedback generation
# Get from: https://smith.langchain.com
LANGSMITH_API_KEY=lsv_your_key_here

# LangSmith Project Name
LANGSMITH_PROJECT=cloud-flight-simulator

# ============================================================================
# DEBUG & LOGGING
# ============================================================================

# Enable debug mode (development only)
DEBUG=true

# Log level: debug, info, warning, error, critical
LOG_LEVEL=info

# ============================================================================
# NOTES
# ============================================================================

# 1. HF_TOKEN is REQUIRED to use OpenAI models via HuggingFace Router
#    Get from: https://huggingface.co/settings/tokens

# 2. Models available via HF Router:
#    - openai/gpt-4-turbo
#    - openai/gpt-4
#    - openai/gpt-3.5-turbo
#    - And many open source models

# 3. Database defaults to SQLite if DATABASE_URL not set
#    For production, use PostgreSQL

# 4. LANGSMITH is optional but recommended for production tracing
