# Cloud Flight Simulator - Environment Configuration Example
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/cloud_flight_simulator

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production-min-32-chars

# OpenAI / LLM Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_API_BASE=https://api.openai.com/v1

# LangSmith Configuration (Optional)
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT_NAME=cloud-flight-simulator
LANGSMITH_TRACING_V2=true

# GCP Configuration
GCP_PROJECT_ID=cloud-flight-sim
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
