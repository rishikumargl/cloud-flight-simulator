# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/cloud_flight_simulator

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_PEM_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
CLERK_ISSUER=https://dynamic-raptor-82.clerk.accounts.dev

# GCP Configuration
GCP_PROJECT_ID=cloud-flight-sim
GCP_KEY_PATH=/path/to/service-account-key.json


LLM_PROVIDER=huggingface
LLM_MODEL=meta-llama/Llama-3.1-8B
LLM_API_KEY=hf_your_token_here
LLM_BASE_URL=https://api-inference.huggingface.co/v1