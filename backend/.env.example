# Database Configuration
# Required: PostgreSQL connection string (e.g., postgresql://user:password@localhost:5432/cloud_flight_simulator)
DATABASE_URL=
# Authentication Configuration
# Required: Secret key for JWT signing (use a strong, random string in production)
SECRET_KEY=

# Optional: JWT algorithm (default: HS256)
ALGORITHM=HS256

# Optional: Access token lifetime in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=

# Optional: Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=

# LLM Configuration (platform-owned, OpenAI-compatible)
# Required: Model name (e.g., 'gpt-4o', 'mixtral-8x7b-32768', 'claude-3-sonnet')
LLM_MODEL=

# Required: API key for the provider
LLM_API_KEY=

# Optional: Base URL for non-OpenAI providers (e.g., Groq, OpenRouter, Together)
# Examples:
#   Groq: https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.io/api/v1
#   Together: https://api.together.ai/v1
# Leave empty for default OpenAI endpoint
LLM_BASE_URL=
