# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cloud_flight_simulator

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# GCP Configuration
# IMPORTANT: Never commit the actual key file. Set this path to a local file outside the repo.
# Example: GCP_KEY_PATH=/home/user/secrets/gcp-service-account.json
GCP_KEY_PATH=/path/to/service-account-key.json
GCP_PROJECT_ID=cloud-flight-sim

# LLM Configuration
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-...
LLM_BASE_URL=             # Optional: for Groq, OpenRouter, etc.
